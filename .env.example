# ============================================================================
# Sheba HMS — Frontend Environment Configuration
# Mirrors the API .env for consistent naming across the platform.
# ============================================================================

# --- Platform Identity ---
VITE_PLATFORM_NAME=Hospital Management System

# --- Tenant Entity (shown in UI) ---
VITE_TENANT_LABEL=Hospital
VITE_TENANT_LABEL_PLURAL=Hospitals

# --- API ---
# Public base URL of the API. In production this is the `api` subdomain of
# BASE_DOMAIN. For local dev use http://localhost:5001 (tenant DB is resolved
# from the browser Origin header, so the subdomain still works cross-port).
VITE_API_URL=https://api.hmsap.com

# --- Base domain ---
# Auto-detected from the browser hostname at runtime when left empty
# (e.g. clinic.hmsap.com -> hmsap.com). Set explicitly to override detection.
VITE_BASE_DOMAIN=hmsap.com

# --- Stripe ---
VITE_STRIPE_PUBLISHABLE_KEY=
