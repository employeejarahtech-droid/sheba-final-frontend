# SPA fallback — serve index.html for client-side routes (TanStack Router, history mode).
# Fixes 404 on refresh/deep-link (e.g. /dashboard) when the site is served by Apache.
# Vite copies this file from public/ into dist/ on `npm run build`.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
