#  HMS Frontend — Production Configuration

# Platform Identity
VITE_PLATFORM_NAME=Hospital Management System
VITE_TENANT_LABEL=Hospital
VITE_TENANT_LABEL_PLURAL=Hospitals

# API Connection — point directly to production API (no proxy)
VITE_API_URL=https://api.hmsap.com

# Multi-Tenant — MUST match the production BASE_DOMAIN (not the dev lvh.me),
# otherwise tenant subdomains like clinic.hmsap.com are treated as the platform
# and every tenant login bounces back to /login.
VITE_BASE_DOMAIN=hmsap.com

# Stripe (publishable key only — safe for frontend)
VITE_STRIPE_PUBLISHABLE_KEY=
